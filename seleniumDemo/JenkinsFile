pipeline {

    agent any

    tools {
        maven 'Maven3'
    }

    triggers {

        githubPush()

        cron('0 6 * * *')

    }

    stages {

        stage('Checkout') {

            steps {

                echo 'Code checked out successfully'

            }

        }

        stage('Build') {

            steps {

                dir('seleniumDemo') {

                    bat 'mvn -version'
                    bat 'mvn clean compile'

                }

            }

        }

        stage('Test') {

            steps {

                dir('seleniumDemo') {

                    bat 'mvn test -Dheadless=true'

                }

            }

            post {

                always {

                    junit allowEmptyResults: true,
                          testResults: 'seleniumDemo/target/surefire-reports/*.xml'

                }

            }

        }

    }